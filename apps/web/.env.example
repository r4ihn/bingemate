# Copy to .env.local for overrides. Vite exposes only VITE_* vars to the client.
# Leave unset to use the dev proxy (/api -> http://localhost:4000).
VITE_API_URL=
# Dev only: pretend to be logged in as ADMIN or MEMBER (skips /auth/me).
# VITE_MOCK_ROLE=MEMBER
# Opt-in mock data: built-in fake titles instead of the real API (for UI work without the API).
# Default: OFF in dev and production builds; only the test suite uses mocks by default.
# VITE_USE_MOCKS=true

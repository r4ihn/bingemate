# Copy to .env.local for overrides. Vite exposes only VITE_* vars to the client.
# Leave unset to use the dev proxy (/api -> http://localhost:4000).
VITE_API_URL=
# Dev only: pretend to be logged in as ADMIN, CREATOR or CONSUMER (skips /auth/me).
# VITE_MOCK_ROLE=CONSUMER
# Mock data for pages until each endpoint is wired. Default: on in dev, OFF in production builds.
# VITE_USE_MOCKS=true

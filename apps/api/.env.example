# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://bingemate:bingemate@localhost:5432/bingemate?schema=public"

# MongoDB (matches docker-compose.yml)
MONGO_URI="mongodb://localhost:27017/bingemate"

# Auth, JWT secret has to be generated
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="2h"

# CORS: the web origin allowed to send credentialed requests
WEB_ORIGIN="http://localhost:5173"

# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL and MongoDB. The ports are per machine: `npm run up` picks free ones, saves them as
# POSTGRES_PORT / MONGO_PORT in the root .env and rewrites the two URLs below to match.
DATABASE_URL="postgresql://bingemate:bingemate@localhost:5432/bingemate?schema=public"
MONGO_URI="mongodb://localhost:27017/bingemate"

# Auth, JWT secret has to be generated
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="2h"

# CORS: the web origin allowed to send credentialed requests
WEB_ORIGIN="http://localhost:5173"

# Minutes between trending refreshes (0 = off)
TRENDING_REFRESH_MINUTES=10

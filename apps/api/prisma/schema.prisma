// BingeMate relational schema (PostgreSQL).
// MongoDB holds review bodies, comments and trending cards — see src/mongo/models.
// Cross-store link: reviews.id === the Mongo ReviewBody _id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
  CONSUMER
}

enum MediaType {
  MOVIE
  BOOK
  TV_SHOW
}

enum TitleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListStatus {
  COMPLETED
  IN_PROGRESS
  PLAN_TO
}

enum PersonRole {
  AUTHOR
  DIRECTOR
  ACTOR
  SHOWRUNNER
  WRITER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String? // display name; the imported dataset's reviewers have one, signed-up users may not
  passwordHash String
  role         Role     @default(CONSUMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTitles Title[]     @relation("CreatedTitles")
  reviews       Review[]
  listEntries   ListEntry[]
}

model Title {
  id              String      @id @default(cuid())
  name            String
  mediaType       MediaType
  status          TitleStatus @default(PENDING)
  rejectionReason String?
  releaseYear     Int?
  description     String?     @db.Text
  posterUrl       String?
  avgRating       Float       @default(0)
  reviewCount     Int         @default(0)

  createdById String?
  createdBy   User?   @relation("CreatedTitles", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  genres       TitleGenre[]
  people       TitlePerson[]
  reviews      Review[]
  listEntries  ListEntry[]
  movieDetails MovieDetails?
  tvDetails    TvDetails?
  bookDetails  BookDetails?

  @@unique([id, mediaType])
  @@index([mediaType])
  @@index([name])
  @@index([status])
  @@index([avgRating])
  @@index([createdById])
  // Omit the measured releaseYear DESC NULLS LAST index: Prisma 5.20 cannot declare NULLS LAST.
  @@index([mediaType, status, avgRating(sort: Desc), reviewCount(sort: Desc), id])
  @@index([mediaType, status, reviewCount(sort: Desc), id])
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  titles TitleGenre[]
}

model TitleGenre {
  titleId String
  genreId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@index([genreId])
}

model Person {
  id     String        @id @default(cuid())
  name   String
  titles TitlePerson[]

  @@index([name])
}

model TitlePerson {
  titleId  String
  personId String
  role     PersonRole
  title    Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  person   Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([titleId, personId, role])
  @@index([personId])
}

model ListEntry {
  id        String     @id @default(cuid())
  userId    String
  titleId   String
  status    ListStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([userId])
  @@index([titleId])
}

// Review HEADER row only. Body + comments live in MongoDB keyed by this id.
model Review {
  id        String   @id @default(cuid())
  userId    String
  titleId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([titleId])
}

// One optional row per title, of the title's own type only: the composite foreign key plus the CHECK
// in the migration refuse anything else. So a title's mediaType cannot change while it has a details
// row; delete the row in the same transaction first.
model MovieDetails {
  titleId          String    @id
  mediaType        MediaType @default(MOVIE)
  runtimeMin       Int?
  tagline          String?
  rated            String?
  letterboxdRating Float?
  title            Title     @relation(fields: [titleId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([titleId, mediaType])
}

model TvDetails {
  titleId       String    @id
  mediaType     MediaType @default(TV_SHOW)
  numSeasons    Int?
  duration      Int?
  contentRating String?
  metascore     Int?
  userscore     Int?
  title         Title     @relation(fields: [titleId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([titleId, mediaType])
}

model BookDetails {
  titleId      String    @id
  mediaType    MediaType @default(BOOK)
  publisher    String?
  ratingsCount Int?
  title        Title     @relation(fields: [titleId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([titleId, mediaType])
}
